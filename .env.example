# =============================================================================
# TEAMEM BOTANICALS — Environment Variables
# =============================================================================

# Vercel Blob Storage Token (Required in production)
# Generated automatically when linking a Vercel Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional flag to force Vercel Blob usage during local testing (default: false)
# When unset or false, the app automatically falls back to local .data/ JSON files.
USE_VERCEL_BLOB="false"
